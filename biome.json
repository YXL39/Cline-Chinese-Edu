{
    "$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true,
        "defaultBranch": "main"
    },
    "files": {
        "ignoreUnknown": true
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "tab",
        "lineWidth": 130
    },
    "linter": {
        "enabled": true
    },
    "javascript": {
        "formatter": {
            "semicolons": "asNeeded"
        }
    }
}
